generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Phrase {
  id            String   @id @default(cuid())
  darijaArabic  String?
  darijaLatin   String
  english       String
  notes         String?
  tag           String?
  audioUrl      String?
  box           Int      @default(1)
  nextReviewAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews Review[]

  @@index([nextReviewAt])
  @@index([tag])
}

model Review {
  id        String   @id @default(cuid())
  phraseId  String
  grade     String
  boxBefore Int
  boxAfter  Int
  reviewedAt DateTime @default(now())

  phrase Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@index([phraseId])
  @@index([reviewedAt])
}

model Streak {
  id                Int      @id @default(1)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastPracticedDate String?
}

model Scenario {
  id          String   @id @default(cuid())
  name        String
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())

  messages ChatMessage[]
  sessions RoleplaySession[]
}

model RoleplaySession {
  id               String   @id @default(cuid())
  scenarioId       String
  scriptFormat     String // "arabizi" | "arabic_script"
  targetPhraseIds  String   @default("[]") // JSON array of Phrase ids, order = numbered list order
  usedPhraseIds    String   @default("[]") // JSON array, phrases confirmed used by the learner
  modeledPhraseIds String   @default("[]") // JSON array, phrases the NPC has modeled
  createdAt        DateTime @default(now())

  scenario Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([scenarioId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  scenarioId String
  sessionId  String?
  role       String
  content    String
  translation String?
  correction  String?
  createdAt  DateTime @default(now())

  scenario Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  session  RoleplaySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([sessionId])
}

model VerbPracticeSession {
  id        String   @id @default(cuid())
  verbs     String // JSON array of verb keys, e.g. ["like","khas","3nd"]
  mode      String // "drill" | "conversation"
  createdAt DateTime @default(now())

  messages VerbPracticeMessage[]
}

model VerbPracticeMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          String // "user" | "assistant"
  content       String
  translation   String? // conversation mode: English translation of the assistant's line
  correction    String? // conversation mode: correction of the learner's last message
  feedback      String? // drill mode: feedback on the learner's previous answer
  verdict       String? // drill mode: "correct" | "close" | "wrong"
  correctAnswer String? // drill mode: correct Darija answer, shown when verdict isn't "correct"
  targetVerb    String? // drill mode, assistant turn: which verb this prompt tested
  targetPerson  String? // drill mode, assistant turn: which grammatical person this prompt tested
  createdAt     DateTime @default(now())

  session VerbPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model VerbMastery {
  id         String   @id @default(cuid())
  verb       String
  person     String // ana | nta | nti | howa | hiya | 7na | ntoma | homa
  strength   Int      @default(0) // 0 = weakest/unpracticed, rises on consecutive correct answers, drops on close/wrong
  attempts   Int      @default(0)
  correct    Int      @default(0)
  lastResult String? // "correct" | "close" | "wrong"
  updatedAt  DateTime @updatedAt

  @@unique([verb, person])
}
